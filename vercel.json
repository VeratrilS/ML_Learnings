{
  "name": "productivity-automations",
  "functions": {
    "api/**/*.py": {
      "includeFiles": "api/default_pdfs/**, api/default_pdfs_metadata.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
